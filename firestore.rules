rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function blockedEither(userA, userB) {
      let blockA = /databases/$(database)/documents/users/$(userA)/blocked/$(userB);
      let blockB = /databases/$(database)/documents/users/$(userB)/blocked/$(userA);
      return exists(blockA) || exists(blockB);
    }

    function isModerator() {
      return signedIn()
        && ('moderator' in request.auth.token)
        && request.auth.token.moderator == true;
    }

    // Suspended or banned members are denied access by the rules themselves.
    // Expired temporary suspensions automatically regain active access.
    function activeMember() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(userPath)
        && (
          get(userPath).data.accountStatus == 'active'
          || (
            get(userPath).data.accountStatus == 'suspended'
            && get(userPath).data.suspensionUntil is timestamp
            && get(userPath).data.suspensionUntil <= request.time
          )
        );
    }

    // A friendship may be created only in the same atomic operation
    // that changes the corresponding request from pending to accepted.
    // An old accepted request cannot authorize recreating a friendship.
    function acceptedFriendPair(userId, friendUid) {
      let pathA = /databases/$(database)/documents/friendRequests/$(friendUid + '_' + userId);
      let pathB = /databases/$(database)/documents/friendRequests/$(userId + '_' + friendUid);

      return (
        exists(pathA) &&
        get(pathA).data.status == 'pending' &&
        existsAfter(pathA) &&
        getAfter(pathA).data.status == 'accepted'
      ) || (
        exists(pathB) &&
        get(pathB).data.status == 'pending' &&
        existsAfter(pathB) &&
        getAfter(pathB).data.status == 'accepted'
      );
    }

    // PRIVATE USER PROFILES
    match /users/{userId} {
      allow read: if ownsUser(userId);

      allow create: if ownsUser(userId)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string;

      allow update: if (
        ownsUser(userId)
        && activeMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'fullName', 'username', 'country', 'photoURL',
            'coverPhotoURL', 'bio', 'updatedAt'
          ])
      ) || (
        isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'accountStatus', 'suspensionUntil',
            'moderationReason', 'moderationUpdatedAt'
          ])
        && request.resource.data.accountStatus in ['active', 'suspended', 'banned']
        && (request.resource.data.suspensionUntil == null
          || request.resource.data.suspensionUntil is timestamp)
        && request.resource.data.moderationReason is string
        && request.resource.data.moderationReason.size() <= 500
        && request.resource.data.moderationUpdatedAt == request.time
      );

      allow delete: if false;

      // FRIENDS SUBCOLLECTION
      match /friends/{friendUid} {
        allow read: if ownsUser(userId) && activeMember();

        allow create, update: if activeMember()
          && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid
          && acceptedFriendPair(userId, friendUid)
          && !blockedEither(userId, friendUid);

        allow delete: if activeMember()
          && (request.auth.uid == userId || request.auth.uid == friendUid);
      }

      // Inbox summaries are stored under each participant's own user document.
      // The owner can query their inbox; either participant may refresh a summary
      // only while the conversation exists and neither side has blocked the other.
      match /inbox/{conversationId} {
        function conversationPath() {
          return /databases/$(database)/documents/conversations/$(conversationId);
        }

        allow get, list: if ownsUser(userId) && activeMember();

        allow create, update: if activeMember()
          && request.auth.uid in request.resource.data.participants
          && userId in request.resource.data.participants
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.otherUid
            == (request.resource.data.participants[0] == userId
              ? request.resource.data.participants[1]
              : request.resource.data.participants[0])
          && existsAfter(conversationPath())
          && getAfter(conversationPath()).data.participants == request.resource.data.participants
          && !blockedEither(
            request.resource.data.participants[0],
            request.resource.data.participants[1]
          )
          && request.resource.data.conversationId == conversationId
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 4000
          && request.resource.data.lastSenderId is string
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'conversationId', 'participants', 'otherUid',
            'lastMessage', 'lastSenderId', 'updatedAt'
          ]);

        // A blocker may atomically remove the other member's inbox summary
        // in the same batch that creates the block record.
        allow delete: if ownsUser(userId) && activeMember()
          || (
            activeMember()
            && resource.data.otherUid == request.auth.uid
            && existsAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(userId)
            )
          );
      }

      // The blocked member can read who blocked them so the client can hide
      // that relationship from discovery, feed and messaging views.
      // Only the original blocker may create or remove this mirror.
      match /blockedBy/{blockerUid} {
        allow read: if ownsUser(userId) && activeMember();
        allow create: if activeMember()
          && request.auth.uid == blockerUid
          && userId != blockerUid
          && request.resource.data.uid == blockerUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && existsAfter(
            /databases/$(database)/documents/users/$(blockerUid)/blocked/$(userId)
          );
        allow delete: if activeMember() && request.auth.uid == blockerUid;
        allow update: if false;
      }

      // In-app friend-request notifications are tied atomically to a real
      // pending friend request. A sender cannot fabricate notifications.
      match /notifications/{notificationId} {
        allow get, list: if ownsUser(userId) && activeMember();

        allow create: if activeMember()
          && request.auth.uid == request.resource.data.actorUid
          && request.resource.data.recipientUid == userId
          && request.resource.data.type == 'friend_request'
          && request.resource.data.requestId == request.resource.data.actorUid + '_' + userId
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 120
          && request.resource.data.actorUsername is string
          && request.resource.data.actorUsername.size() <= 40
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
          && request.resource.data.keys().hasOnly([
            'type', 'actorUid', 'recipientUid', 'requestId',
            'actorName', 'actorUsername', 'createdAt', 'readAt'
          ])
          && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == userId
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';

        allow update: if ownsUser(userId) && activeMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && (request.resource.data.readAt == null
            || request.resource.data.readAt == request.time);

        allow delete: if ownsUser(userId) && activeMember();
      }

      // A member can manage only their own block list.
      match /blocked/{blockedUid} {
        allow read: if ownsUser(userId) && activeMember();
        allow create: if ownsUser(userId) && activeMember()
          && blockedUid != userId
          && request.resource.data.uid == blockedUid
          && request.resource.data.keys().hasOnly(['uid', 'fullName', 'createdAt'])
          && (!('fullName' in request.resource.data)
            || (request.resource.data.fullName is string
              && request.resource.data.fullName.size() <= 120));
        allow update: if false;
        allow delete: if ownsUser(userId) && activeMember();
      }
    }

    // PUBLIC PROFILE DIRECTORY
    match /publicProfiles/{userId} {
      // Keep directory queries available for discovery. A direct profile lookup
      // is denied when either member has blocked the other.
      allow get: if activeMember() && !blockedEither(request.auth.uid, userId);
      allow list: if activeMember();

      allow create, update: if ownsUser(userId) && activeMember()
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'username',
          'country',
          'bio',
          'photoURL',
          'coverPhotoURL',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // POSTS
    match /posts/{postId} {
      // Feed queries are filtered client-side; direct post links respect blocks.
      allow get: if activeMember()
        && !blockedEither(request.auth.uid, resource.data.authorId);
      allow list: if activeMember();

      allow create: if activeMember()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if false;

      allow delete: if activeMember()
        && resource.data.authorId == request.auth.uid;

      // LIKES
      match /likes/{likeId} {
        allow read: if activeMember();

        allow create: if activeMember()
          && likeId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && !blockedEither(
            request.auth.uid,
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          );

        allow update: if false;

        allow delete: if activeMember()
          && (
            likeId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          );
      }

      // COMMENTS
      match /comments/{commentId} {
        allow read: if activeMember();

        allow create: if activeMember()
          && request.resource.data.authorId == request.auth.uid
          && !blockedEither(
            request.auth.uid,
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if false;

        allow delete: if activeMember()
          && resource.data.authorId == request.auth.uid;
      }
    }


    // PRIVATE CONVERSATIONS
    match /conversations/{conversationId} {
      function isParticipant() {
        return activeMember()
          && request.auth.uid in resource.data.participants;
      }

      // A signed-in sender may check whether a deterministic conversation
      // document exists before creating it. Existing conversations remain
      // readable only by their two participants.
      allow get: if activeMember()
        && (
          resource == null ||
          (
            isParticipant() &&
            !blockedEither(resource.data.participants[0], resource.data.participants[1])
          )
        );
      allow list: if isParticipant()
        && !blockedEither(resource.data.participants[0], resource.data.participants[1]);

      allow create: if activeMember()
        && request.resource.data.keys().hasAll([
          'participants', 'createdBy', 'lastMessage',
          'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'participants', 'createdBy', 'lastMessage',
          'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && !blockedEither(request.resource.data.participants[0], request.resource.data.participants[1])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isParticipant()
        && !blockedEither(resource.data.participants[0], resource.data.participants[1])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        allow read: if activeMember()
          && parentConversation().data.participants.hasAny([request.auth.uid])
          && !blockedEither(
            parentConversation().data.participants[0],
            parentConversation().data.participants[1]
          );

        allow create: if activeMember()
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
          && !blockedEither(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
          )
          && request.resource.data.keys().hasAll([
            'text', 'senderId', 'senderName', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'text', 'senderId', 'senderName', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // USER REPORTS: reporters can create/read their own reports.
    // Trusted moderators need a Firebase Auth custom claim: moderator=true.
    match /reports/{reportId} {
      allow create: if activeMember()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.contentId is string
        && request.resource.data.contentType in ['post', 'account', 'comment', 'message', 'live_stream']
        && request.resource.data.reason in [
          'harassment', 'hate', 'violence', 'sexual', 'spam', 'privacy', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetUid', 'contentType', 'contentId',
          'reason', 'details', 'status', 'createdAt'
        ]);
      allow read: if (activeMember() && resource.data.reporterId == request.auth.uid) || isModerator();
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatorNote', 'resolvedAt'])
        && request.resource.data.status in ['open', 'reviewing', 'resolved', 'dismissed']
        && (!('moderatorNote' in request.resource.data)
          || (request.resource.data.moderatorNote is string
            && request.resource.data.moderatorNote.size() <= 1000));
      allow delete: if false;
    }

    // PRIVATE MODERATION ACCOUNT STATE. Members can read only their own
    // status/notice; moderators can review and update the limited status mirror.
    match /moderationAccounts/{targetUid} {
      allow get: if isModerator() || ownsUser(targetUid);
      allow list: if isModerator();
      allow create, update: if isModerator()
        && request.resource.data.uid == targetUid
        && request.resource.data.keys().hasOnly([
          'uid', 'accountStatus', 'suspensionUntil', 'reason',
          'warningCount', 'latestWarning', 'warningAt', 'updatedAt'
        ])
        && request.resource.data.accountStatus in ['active', 'suspended', 'banned']
        && (request.resource.data.suspensionUntil == null
          || request.resource.data.suspensionUntil is timestamp)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.warningCount is int
        && request.resource.data.warningCount >= 0
        && request.resource.data.latestWarning is string
        && request.resource.data.latestWarning.size() <= 500
        && (request.resource.data.warningAt == null
          || request.resource.data.warningAt is timestamp)
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(targetUid))
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.accountStatus
          == request.resource.data.accountStatus
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.suspensionUntil
          == request.resource.data.suspensionUntil;
      allow delete: if false;
    }

    // Append-only moderation audit trail. Members can see only actions
    // concerning their own account; moderators can review the full history.
    match /moderationActions/{actionId} {
      allow create: if isModerator()
        && request.resource.data.moderatorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.action in ['warning', 'suspend', 'ban', 'reinstate']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && (request.resource.data.durationHours == null
          || (request.resource.data.durationHours is int
            && request.resource.data.durationHours in [24, 168, 720]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'targetUid', 'moderatorUid', 'action', 'reason',
          'durationHours', 'createdAt'
        ]);
      allow read: if isModerator()
        || (signedIn() && resource.data.targetUid == request.auth.uid);
      allow update, delete: if false;
    }

    // Suspended members retain a narrow, private appeal channel.
    match /moderationAppeals/{appealId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus
          in ['suspended', 'banned']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'reason', 'status', 'createdAt'
        ]);
      allow read: if isModerator()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatorNote', 'reviewedAt'])
        && request.resource.data.status in ['open', 'reviewing', 'accepted', 'rejected']
        && request.resource.data.moderatorNote is string
        && request.resource.data.moderatorNote.size() <= 1000
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow read: if activeMember()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow create: if activeMember()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && !blockedEither(request.auth.uid, request.resource.data.toUid);

      allow update: if activeMember()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && !blockedEither(resource.data.fromUid, resource.data.toUid)
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt']);

      allow delete: if activeMember()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }
    // LIVE BROADCASTS. Only active members can discover and participate.
    // The host owns the stream document; comments are append-only.
    match /liveStreams/{streamId} {
      allow get, list: if activeMember();
      allow create: if activeMember()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'live'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastHeartbeat == request.time
        && request.resource.data.keys().hasOnly([
          'hostUid', 'hostName', 'title', 'status', 'createdAt', 'lastHeartbeat'
        ]);
      allow update: if activeMember()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status == 'live'
        && (
          (request.resource.data.status == 'ended'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
            && request.resource.data.endedAt == request.time)
          ||
          (request.resource.data.status == 'live'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat'])
            && request.resource.data.lastHeartbeat == request.time)
          ||
          (request.resource.data.status == 'live'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pinnedCommentText', 'pinnedCommentSenderName', 'pinnedBy', 'pinnedAt'
            ])
            && request.resource.data.pinnedBy == request.auth.uid
            && request.resource.data.pinnedAt == request.time
            && (request.resource.data.pinnedCommentText == null
              || (request.resource.data.pinnedCommentText is string
                && request.resource.data.pinnedCommentText.size() > 0
                && request.resource.data.pinnedCommentText.size() <= 500))
            && (request.resource.data.pinnedCommentSenderName == null
              || (request.resource.data.pinnedCommentSenderName is string
                && request.resource.data.pinnedCommentSenderName.size() <= 120)))
        );
      allow delete: if false;

      match /guestRequests/{guestUid} {
        allow get: if activeMember()
          && (request.auth.uid == guestUid || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid);
        allow list: if activeMember() && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid;
        allow create: if activeMember() && request.auth.uid == guestUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'status', 'createdAt']);
        allow update: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.respondedAt == request.time;
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow read: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live';
        allow create: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt']);
        allow update, delete: if false;
      }

      // Append-only live reactions. Client pacing is only a UI safeguard;
      // production anti-spam enforcement should be moved to a trusted endpoint.
      match /heartEvents/{heartId} {
        allow read: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live';
        allow create: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'createdAt']);
        allow update, delete: if false;
      }

      // FREE LIVE GIFTS ONLY. Paid gifts and money balances must be handled
      // by a trusted payment backend, never by client-side Firestore writes.
      match /giftEvents/{giftId} {
        allow read: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live';
        allow create: if activeMember()
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.giftId in ['heart', 'rose', 'clap', 'star']
          && request.resource.data.giftName in ['Heart', 'Rose', 'Clap', 'Star']
          && request.resource.data.emoji in ['❤️', '🌹', '👏', '⭐']
          && request.resource.data.kind == 'free'
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'giftId', 'giftName',
            'emoji', 'kind', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

  }
}
