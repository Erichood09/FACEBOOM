rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function blockedEither(userA, userB) {
      let blockA = /databases/$(database)/documents/users/$(userA)/blocked/$(userB);
      let blockB = /databases/$(database)/documents/users/$(userB)/blocked/$(userA);
      return exists(blockA) || exists(blockB);
    }

    function isModerator() {
      return signedIn() && request.auth.token.moderator == true;
    }

    // A friendship may be created only in the same atomic operation
    // that changes the corresponding request from pending to accepted.
    // An old accepted request cannot authorize recreating a friendship.
    function acceptedFriendPair(userId, friendUid) {
      let pathA = /databases/$(database)/documents/friendRequests/$(friendUid + '_' + userId);
      let pathB = /databases/$(database)/documents/friendRequests/$(userId + '_' + friendUid);

      return (
        exists(pathA) &&
        get(pathA).data.status == 'pending' &&
        existsAfter(pathA) &&
        getAfter(pathA).data.status == 'accepted'
      ) || (
        exists(pathB) &&
        get(pathB).data.status == 'pending' &&
        existsAfter(pathB) &&
        getAfter(pathB).data.status == 'accepted'
      );
    }

    // PRIVATE USER PROFILES
    match /users/{userId} {
      allow read: if ownsUser(userId);

      allow create: if ownsUser(userId)
        && request.resource.data.accountStatus == 'active';

      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'fullName',
            'username',
            'country',
            'photoURL',
            'coverPhotoURL',
            'bio',
            'email',
            'updatedAt'
          ]);

      allow delete: if false;

      // FRIENDS SUBCOLLECTION
      match /friends/{friendUid} {
        allow read: if ownsUser(userId);

        allow create, update: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid
          && acceptedFriendPair(userId, friendUid)
          && !blockedEither(userId, friendUid);

        allow delete: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == friendUid);
      }

      // A member can manage only their own block list.
      match /blocked/{blockedUid} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && blockedUid != userId
          && request.resource.data.uid == blockedUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
        allow update: if false;
        allow delete: if ownsUser(userId);
      }
    }

    // PUBLIC PROFILE DIRECTORY
    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'username',
          'country',
          'bio',
          'photoURL',
          'coverPhotoURL',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // POSTS
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      // LIKES
      match /likes/{likeId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && likeId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow update: if false;

        allow delete: if signedIn()
          && (
            likeId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          );
      }

      // COMMENTS
      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if false;

        allow delete: if signedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }


    // PRIVATE CONVERSATIONS
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participants;
      }

      // A signed-in sender may check whether a deterministic conversation
      // document exists before creating it. Existing conversations remain
      // readable only by their two participants.
      allow get: if signedIn()
        && (resource == null || isParticipant());
      allow list: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'participants', 'createdBy', 'lastMessage',
          'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'participants', 'createdBy', 'lastMessage',
          'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && !blockedEither(request.resource.data.participants[0], request.resource.data.participants[1])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isParticipant()
        && !blockedEither(resource.data.participants[0], resource.data.participants[1])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        allow read: if signedIn()
          && parentConversation().data.participants.hasAny([request.auth.uid]);

        allow create: if signedIn()
          && parentConversation().data.participants.hasAny([request.auth.uid])
          && !blockedEither(parentConversation().data.participants[0], parentConversation().data.participants[1])
          && request.resource.data.keys().hasAll([
            'text', 'senderId', 'senderName', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'text', 'senderId', 'senderName', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // USER REPORTS: reporters can create/read their own reports.
    // Trusted moderators need a Firebase Auth custom claim: moderator=true.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.contentType in ['post', 'account', 'comment', 'message']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetUid', 'contentType', 'contentId',
          'reason', 'details', 'status', 'createdAt'
        ]);
      allow read: if signedIn()
        && (resource.data.reporterId == request.auth.uid || isModerator());
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatorNote', 'resolvedAt']);
      allow delete: if false;
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && !blockedEither(request.auth.uid, request.resource.data.toUid);

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && !blockedEither(resource.data.fromUid, resource.data.toUid)
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt']);

      allow delete: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }
  }
}
